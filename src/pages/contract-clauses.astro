---
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>合同修改常用表述｜YU之宝库</title>

    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        min-height: 100%;
        background: #08070e;
      }

      :global(body) {
        position: relative;
        min-height: 100vh;
        margin: 0;
        overflow-x: hidden;
        color: #eeeeec;
        font-family:
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          "PingFang SC",
          "Hiragino Sans GB",
          "Microsoft YaHei",
          sans-serif;

        /* 与主页统一的深紫渐变背景 */
        background:
          radial-gradient(
            ellipse at 15% 10%,
            rgba(88, 65, 150, 0.25),
            transparent 30%
          ),
          radial-gradient(
            ellipse at 86% 23%,
            rgba(67, 48, 126, 0.22),
            transparent 34%
          ),
          radial-gradient(
            ellipse at 52% 83%,
            rgba(53, 38, 108, 0.23),
            transparent 40%
          ),
          linear-gradient(
            135deg,
            #08070e 0%,
            #100c1d 35%,
            #0d0918 68%,
            #05050a 100%
          );
        background-attachment: fixed;
      }

      /* 页面主体位于星空背景上方 */
      .page {
        position: relative;
        z-index: 1;
        min-height: 100vh;
      }

      /* 星空背景 */
      .stars {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background-repeat: no-repeat;
      }

      .stars-one {
        opacity: 0.72;
        background-image:
          radial-gradient(circle at 4% 12%, rgba(235, 230, 255, 0.68) 0 0.8px, transparent 1.2px),
          radial-gradient(circle at 17% 31%, rgba(220, 214, 255, 0.55) 0 0.7px, transparent 1.1px),
          radial-gradient(circle at 29% 18%, rgba(235, 230, 255, 0.6) 0 0.8px, transparent 1.2px),
          radial-gradient(circle at 41% 9%, rgba(215, 207, 255, 0.52) 0 0.7px, transparent 1.1px),
          radial-gradient(circle at 53% 38%, rgba(235, 230, 255, 0.58) 0 0.8px, transparent 1.2px),
          radial-gradient(circle at 64% 16%, rgba(220, 214, 255, 0.6) 0 0.8px, transparent 1.2px),
          radial-gradient(circle at 74% 29%, rgba(225, 220, 255, 0.5) 0 0.7px, transparent 1.1px),
          radial-gradient(circle at 88% 13%, rgba(235, 230, 255, 0.58) 0 0.8px, transparent 1.2px),
          radial-gradient(circle at 94% 44%, rgba(220, 214, 255, 0.5) 0 0.7px, transparent 1.1px),
          radial-gradient(circle at 10% 73%, rgba(225, 220, 255, 0.5) 0 0.7px, transparent 1.1px),
          radial-gradient(circle at 34% 85%, rgba(235, 230, 255, 0.55) 0 0.8px, transparent 1.2px),
          radial-gradient(circle at 59% 72%, rgba(220, 214, 255, 0.5) 0 0.7px, transparent 1.1px),
          radial-gradient(circle at 81% 88%, rgba(235, 230, 255, 0.55) 0 0.8px, transparent 1.2px);
      }

      .stars-two {
        opacity: 0.48;
        background-image:
          radial-gradient(circle at 8% 42%, rgba(220, 214, 255, 0.5) 0 0.5px, transparent 0.9px),
          radial-gradient(circle at 22% 8%, rgba(235, 230, 255, 0.45) 0 0.5px, transparent 0.9px),
          radial-gradient(circle at 37% 53%, rgba(220, 214, 255, 0.5) 0 0.5px, transparent 0.9px),
          radial-gradient(circle at 48% 24%, rgba(235, 230, 255, 0.4) 0 0.5px, transparent 0.9px),
          radial-gradient(circle at 68% 48%, rgba(220, 214, 255, 0.45) 0 0.5px, transparent 0.9px),
          radial-gradient(circle at 78% 8%, rgba(235, 230, 255, 0.45) 0 0.5px, transparent 0.9px),
          radial-gradient(circle at 91% 65%, rgba(220, 214, 255, 0.5) 0 0.5px, transparent 0.9px),
          radial-gradient(circle at 15% 91%, rgba(235, 230, 255, 0.4) 0 0.5px, transparent 0.9px),
          radial-gradient(circle at 45% 91%, rgba(220, 214, 255, 0.45) 0 0.5px, transparent 0.9px),
          radial-gradient(circle at 71% 79%, rgba(235, 230, 255, 0.4) 0 0.5px, transparent 0.9px);
      }

      .stars-three {
        opacity: 0.3;
        background-image:
          radial-gradient(circle at 12% 23%, rgba(235, 230, 255, 0.5) 0 0.4px, transparent 0.8px),
          radial-gradient(circle at 27% 63%, rgba(220, 214, 255, 0.4) 0 0.4px, transparent 0.8px),
          radial-gradient(circle at 44% 34%, rgba(235, 230, 255, 0.45) 0 0.4px, transparent 0.8px),
          radial-gradient(circle at 62% 58%, rgba(220, 214, 255, 0.4) 0 0.4px, transparent 0.8px),
          radial-gradient(circle at 83% 37%, rgba(235, 230, 255, 0.45) 0 0.4px, transparent 0.8px),
          radial-gradient(circle at 96% 82%, rgba(220, 214, 255, 0.4) 0 0.4px, transparent 0.8px);
      }

      /* 淡紫色星云 */
      .nebula {
        position: fixed;
        z-index: 0;
        width: 520px;
        height: 520px;
        border-radius: 50%;
        pointer-events: none;
        filter: blur(115px);
      }

      .nebula-one {
        top: -280px;
        left: -180px;
        background: rgba(102, 78, 169, 0.2);
      }

      .nebula-two {
        right: -240px;
        bottom: -270px;
        background: rgba(70, 49, 135, 0.18);
      }

      .topbar {
        height: 72px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 48px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.07);
      }

      .logo {
        color: #eee8f5;
        text-decoration: none;
        font-size: 16px;
        letter-spacing: 0.12em;
      }

      .nav {
        display: flex;
        gap: 28px;
      }

      .nav a {
        color: #aaa2b5;
        text-decoration: none;
        font-size: 13px;
        transition: color 0.2s ease;
      }

      .nav a:hover {
        color: #eee8f5;
      }

      .main {
        width: min(900px, calc(100% - 48px));
        margin: 0 auto;
        padding: 70px 0 100px;
      }

      .page-label {
        margin-bottom: 16px;
        color: #a48ab9;
        font-size: 13px;
        letter-spacing: 0.14em;
      }

      h1 {
        margin: 0 0 50px;
        color: #eeeeec;
        font-size: 30px;
        font-weight: 500;
        letter-spacing: 0.04em;
      }

      .categories {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
      }

      .category-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 88px;
        padding: 22px 24px;
        border: 1px solid rgba(173, 160, 226, 0.16);
        background: rgba(255, 255, 255, 0.018);
        color: #ddd7e4;
        text-decoration: none;
        transition:
          border-color 0.2s ease,
          background 0.2s ease,
          transform 0.2s ease;
      }

      .category-card:hover {
        border-color: rgba(180, 150, 205, 0.4);
        background: rgba(180, 150, 205, 0.055);
        transform: translateY(-2px);
      }

      .category-name {
        color: #ddd7e4;
        font-size: 15px;
      }

      .category-number {
        color: #77717f;
        font-size: 12px;
        letter-spacing: 0.08em;
      }

      .loading,
      .error {
        padding: 30px;
        border: 1px solid rgba(173, 160, 226, 0.16);
        background: rgba(255, 255, 255, 0.018);
        color: #aaa2b5;
        font-size: 14px;
      }

      .error {
        color: #c5a4df;
      }

      @media (max-width: 700px) {
        .topbar {
          padding: 0 22px;
        }

        .nav {
          gap: 18px;
        }

        .main {
          width: min(calc(100% - 32px), 900px);
          padding-top: 48px;
        }

        h1 {
          font-size: 25px;
          margin-bottom: 36px;
        }

        .categories {
          grid-template-columns: 1fr;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .category-card,
        .nav a {
          transition: none;
        }
      }
    </style>
  </head>

  <body>
    <!-- 星空背景 -->
    <div class="stars stars-one" aria-hidden="true"></div>
    <div class="stars stars-two" aria-hidden="true"></div>
    <div class="stars stars-three" aria-hidden="true"></div>

    <!-- 紫色星云 -->
    <div class="nebula nebula-one" aria-hidden="true"></div>
    <div class="nebula nebula-two" aria-hidden="true"></div>

    <div class="page">
      <header class="topbar">
        <a href={import.meta.env.BASE_URL} class="logo">YU之宝库</a>

        <nav class="nav">
          <a href={`${import.meta.env.BASE_URL}archive/`}>案例库</a>
          <a href={import.meta.env.BASE_URL}>首页</a>
        </nav>
      </header>

      <main class="main">
        <div id="loading" class="loading">
          正在验证访问权限……
        </div>

        <div id="error" class="error" style="display: none;">
          无权访问。
        </div>

        <div id="content" style="display: none;">
          <div class="page-label">
            PRIVATE · CONTRACT CLAUSES
          </div>

          <h1>合同修改常用表述</h1>

          <div class="categories">
            <a
              href={`${import.meta.env.BASE_URL}contract-clause-detail/?id=1`}
              class="category-card"
            >
              <span class="category-name">付款条款</span>
              <span class="category-number">01</span>
            </a>

            <a
              href={`${import.meta.env.BASE_URL}contract-clause-detail/?id=2`}
              class="category-card"
            >
              <span class="category-name">交付/履行</span>
              <span class="category-number">02</span>
            </a>

            <a
              href={`${import.meta.env.BASE_URL}contract-clause-detail/?id=3`}
              class="category-card"
            >
              <span class="category-name">验收</span>
              <span class="category-number">03</span>
            </a>

            <a
              href={`${import.meta.env.BASE_URL}contract-clause-detail/?id=4`}
              class="category-card"
            >
              <span class="category-name">违约责任</span>
              <span class="category-number">04</span>
            </a>

            <a
              href={`${import.meta.env.BASE_URL}contract-clause-detail/?id=5`}
              class="category-card"
            >
              <span class="category-name">合同解除</span>
              <span class="category-number">05</span>
            </a>

            <a
              href={`${import.meta.env.BASE_URL}contract-clause-detail/?id=6`}
              class="category-card"
            >
              <span class="category-name">赔偿责任</span>
              <span class="category-number">06</span>
            </a>

            <a
              href={`${import.meta.env.BASE_URL}contract-clause-detail/?id=7`}
              class="category-card"
            >
              <span class="category-name">责任限制</span>
              <span class="category-number">07</span>
            </a>

            <a
              href={`${import.meta.env.BASE_URL}contract-clause-detail/?id=8`}
              class="category-card"
            >
              <span class="category-name">知识产权</span>
              <span class="category-number">08</span>
            </a>

            <a
              href={`${import.meta.env.BASE_URL}contract-clause-detail/?id=9`}
              class="category-card"
            >
              <span class="category-name">保密</span>
              <span class="category-number">09</span>
            </a>

            <a
              href={`${import.meta.env.BASE_URL}contract-clause-detail/?id=10`}
              class="category-card"
            >
              <span class="category-name">争议解决</span>
              <span class="category-number">10</span>
            </a>

            <a
              href={`${import.meta.env.BASE_URL}contract-clause-detail/?id=11`}
              class="category-card"
            >
              <span class="category-name">通知与送达</span>
              <span class="category-number">11</span>
            </a>

            <a
              href={`${import.meta.env.BASE_URL}contract-clause-detail/?id=12`}
              class="category-card"
            >
              <span class="category-name">不可抗力</span>
              <span class="category-number">12</span>
            </a>

            <a
              href={`${import.meta.env.BASE_URL}contract-clause-detail/?id=13`}
              class="category-card"
            >
              <span class="category-name">其他</span>
              <span class="category-number">13</span>
            </a>
          </div>
        </div>
      </main>
    </div>

    <script>
      import { supabase } from "../lib/supabase";

      const loading =
        document.querySelector("#loading") as HTMLElement | null;

      const errorBox =
        document.querySelector("#error") as HTMLElement | null;

      const content =
        document.querySelector("#content") as HTMLElement | null;

      if (!loading || !errorBox || !content) {
        throw new Error("页面元素加载失败");
      }

      const checkLogin = async () => {
        const {
          data: { user },
        } = await supabase.auth.getUser();

        if (!user) {
          window.location.href = import.meta.env.BASE_URL + "login/";
          return;
        }

        loading.style.display = "none";
        content.style.display = "block";
      };

      checkLogin();
    </script>
  </body>
</html>
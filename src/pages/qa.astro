---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Q&A">
  <div class="page">
    <header class="topbar">
      <a href={import.meta.env.BASE_URL} class="brand">YU之宝库</a>

      <nav>
        <a href={`${import.meta.env.BASE_URL}archive`}>案例</a>
        <a href={`${import.meta.env.BASE_URL}qa`} class="active">Q&A</a>
        <a href={`${import.meta.env.BASE_URL}login`}>登录</a>
      </nav>
    </header>

    <main>
      <div class="page-head">
        <div>
          <div class="small-title">日常法律问题</div>
          <h1>Q&A</h1>
        </div>

        <a href={`${import.meta.env.BASE_URL}qa-new`} class="new-btn">＋ 新增问题</a>
      </div>

      <div class="search-row">
        <div class="search-box">
          <span>⌕</span>
          <input
            id="search"
            type="text"
            placeholder="关键词"
            autocomplete="off"
          />
        </div>

        <div id="count" class="count">加载中</div>
      </div>

      <div id="list" class="qa-list">
        <div class="loading">正在加载……</div>
      </div>
    </main>
  </div>

  <script>
    import { supabase } from "../lib/supabase";

    type QaItem = {
      id: number;
      question: string;
      answer: string;
      keywords: string | null;
      created_at: string | null;
      updated_at: string | null;
    };

    const list = document.getElementById("list") as HTMLElement;
    const search = document.getElementById("search") as HTMLInputElement;
    const count = document.getElementById("count") as HTMLElement;

    let allQa: QaItem[] = [];

    function escapeHtml(value: string) {
      return value
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function render(items: QaItem[]) {
      count.textContent = `${items.length} 条`;

      if (items.length === 0) {
        list.innerHTML = `
          <div class="empty">
            没有找到相关问题
          </div>
        `;
        return;
      }

      list.innerHTML = items
        .map((item, index) => {
          return `
            <a
              href="${import.meta.env.BASE_URL}qa-detail?id=${item.id}"
              class="qa-item"
            >
              <div class="item-number">
                ${String(index + 1).padStart(2, "0")}
              </div>

              <div class="item-content">
                <div class="item-question">
                  ${escapeHtml(item.question)}
                </div>

                <div class="item-keywords">
                  ${
                    item.keywords
                      ? escapeHtml(item.keywords)
                      : "暂无关键词"
                  }
                </div>
              </div>

              <div class="item-arrow">→</div>
            </a>
          `;
        })
        .join("");
    }

    function filterList(keyword: string) {
      const value = keyword.trim().toLowerCase();

      if (!value) {
        render(allQa);
        return;
      }

      const result = allQa.filter((item) => {
        return (
          item.question.toLowerCase().includes(value) ||
          item.answer.toLowerCase().includes(value) ||
          (item.keywords ?? "").toLowerCase().includes(value)
        );
      });

      render(result);
    }

    async function loadQa() {
      const {
        data: { session },
      } = await supabase.auth.getSession();

      if (!session) {
        window.location.href = "/login";
        return;
      }

      const { data, error } = await supabase
        .from("qa")
        .select(
          "id, question, answer, keywords, created_at, updated_at"
        )
        .eq("user_id", session.user.id)
        .order("created_at", { ascending: false });

      if (error) {
        list.innerHTML = `
          <div class="empty">
            加载失败：${escapeHtml(error.message)}
          </div>
        `;
        count.textContent = "";
        return;
      }

      allQa = (data ?? []) as QaItem[];

      render(allQa);
    }

    search.addEventListener("input", () => {
      filterList(search.value);
    });

    loadQa();
  </script>

  <style>
    :global(body) {
      margin: 0;
      background: #09070f;
      color: #f5f2f8;
      font-family:
        -apple-system,
        BlinkMacSystemFont,
        "SF Pro Display",
        "Helvetica Neue",
        Arial,
        sans-serif;
    }

    .page {
      min-height: 100vh;
      background:
        radial-gradient(
          circle at 50% 0%,
          rgba(105, 70, 155, 0.13),
          transparent 38%
        ),
        #09070f;
    }

    .topbar {
      height: 76px;
      padding: 0 6vw;
      box-sizing: border-box;

      display: flex;
      align-items: center;
      justify-content: space-between;

      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .brand {
      font-size: 18px;
      letter-spacing: 0.08em;
      color: #ffffff;
      text-decoration: none;
    }

    .brand:hover {
      color: #ffffff;
    }

    nav {
      display: flex;
      gap: 28px;
    }

    nav a {
      color: rgba(255, 255, 255, 0.72);
      text-decoration: none;
      font-size: 14px;
      transition: color 0.2s ease;
    }

    nav a:hover,
    nav a.active {
      color: #ffffff;
    }

    main {
      width: min(960px, 88vw);
      margin: 0 auto;
      padding: 68px 0 100px;
    }

    .page-head {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      margin-bottom: 42px;
    }

    .small-title {
      margin-bottom: 13px;
      color: rgba(255, 255, 255, 0.7);
      font-size: 12px;
      letter-spacing: 0.16em;
    }

    h1 {
      margin: 0;
      font-size: 40px;
      font-weight: 500;
      letter-spacing: 0.02em;
      color: #ffffff;
    }

    .new-btn {
      height: 40px;
      padding: 0 18px;

      display: inline-flex;
      align-items: center;
      justify-content: center;

      border: 1px solid rgba(210, 180, 240, 0.55);
      background: rgba(125, 91, 177, 0.1);

      color: #ffffff;
      text-decoration: none;
      font-size: 13px;

      box-sizing: border-box;
      transition: 0.2s ease;
    }

    .new-btn:hover {
      border-color: rgba(225, 205, 245, 0.9);
      background: rgba(125, 91, 177, 0.22);
    }

    .search-row {
      display: flex;
      align-items: center;
      gap: 15px;
      margin-bottom: 22px;
    }

    .search-box {
      height: 46px;
      flex: 1;

      display: flex;
      align-items: center;
      gap: 10px;

      padding: 0 15px;
      box-sizing: border-box;

      border: 1px solid rgba(255, 255, 255, 0.2);
      background: rgba(255, 255, 255, 0.035);

      transition: 0.2s ease;
    }

    .search-box:focus-within {
      border-color: rgba(220, 190, 250, 0.8);
      background: rgba(126, 91, 179, 0.1);
      box-shadow: 0 0 0 3px rgba(126, 91, 179, 0.09);
    }

    .search-box span {
      color: rgba(255, 255, 255, 0.7);
      font-size: 20px;
    }

    .search-box input {
      flex: 1;
      width: 100%;

      border: 0;
      outline: none;
      background: transparent;

      color: #ffffff;
      font-size: 14px;
    }

    .search-box input::placeholder {
      color: rgba(255, 255, 255, 0.5);
    }

    .count {
      width: 50px;
      text-align: right;
      color: rgba(255, 255, 255, 0.62);
      font-size: 12px;
    }

    .qa-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .qa-item {
      display: flex;
      align-items: center;

      width: 100%;
      min-height: 78px;

      padding: 17px 19px;
      box-sizing: border-box;

      border: 1px solid rgba(205, 180, 230, 0.38);
      background: rgba(20, 15, 29, 0.72);

      text-decoration: none;
      color: inherit;

      transition:
        border-color 0.18s ease,
        background 0.18s ease,
        box-shadow 0.18s ease,
        transform 0.18s ease;
    }

    .qa-item:hover {
      border-color: rgba(225, 200, 250, 0.9);

      background: rgba(105, 72, 145, 0.2);

      box-shadow:
        0 0 0 1px rgba(225, 200, 250, 0.14),
        0 8px 28px rgba(35, 17, 58, 0.35);

      transform: translateY(-1px);
    }

    .qa-item:active {
      border-color: #ffffff;

      background: rgba(119, 80, 164, 0.3);

      box-shadow:
        0 0 0 3px rgba(190, 150, 235, 0.14);

      transform: translateY(0);
    }

    .item-number {
      width: 38px;
      flex: 0 0 38px;

      color: rgba(255, 255, 255, 0.55);
      font-size: 11px;
      letter-spacing: 0.08em;
    }

    .item-content {
      min-width: 0;
      flex: 1;
    }

    .item-question {
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;

      color: #ffffff;
      font-size: 14px;
      line-height: 1.5;
    }

    .item-keywords {
      margin-top: 6px;

      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;

      color: rgba(255, 255, 255, 0.72);
      font-size: 11px;
      line-height: 1.4;
    }

    .item-arrow {
      margin-left: 18px;

      color: rgba(255, 255, 255, 0.55);
      font-size: 17px;

      transition: 0.18s ease;
    }

    .qa-item:hover .item-arrow {
      color: #ffffff;
      transform: translateX(4px);
    }

    .loading,
    .empty {
      border: 1px solid rgba(205, 180, 230, 0.3);

      padding: 50px 20px;

      text-align: center;

      color: rgba(255, 255, 255, 0.7);

      background: rgba(20, 15, 29, 0.55);

      font-size: 13px;
    }

    @media (max-width: 700px) {
      .topbar {
        padding: 0 5vw;
      }

      nav {
        gap: 18px;
      }

      main {
        width: 90vw;
        padding-top: 48px;
      }

      .page-head {
        align-items: flex-start;
        flex-direction: column;
        gap: 24px;
      }

      h1 {
        font-size: 34px;
      }

      .new-btn {
        width: 100%;
      }

      .count {
        display: none;
      }

      .qa-item {
        min-height: 72px;
        padding: 14px;
      }

      .item-number {
        width: 27px;
        flex-basis: 27px;
      }
    }
  </style>
</Layout>
    padding:
      82px 0 48px;
  }

  .hero-label {
    display: flex;
    align-items: center;
    gap: 8px;
    color:
      var(--purple);
    font-size: 9px;
    letter-spacing: 2px;
  }

  .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background:
      var(--purple);
    box-shadow:
      0 0 10px
      rgba(
        170,
        160,
        223,
        0.8
      );
  }

  /*
   * 主标题
   */

  h1 {
    margin:
      18px 0 0;
    line-height: 1;
    font-size: 44px;
    font-weight: 400;
    letter-spacing:
      -2.5px;
  }


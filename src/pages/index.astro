      border-color 0.2s ease,
      background 0.2s ease;

    margin-bottom: 11px;
  }

  .private-card:hover {
    border-color:
      rgba(
        165,
        153,
        218,
        0.5
      );
    background:
      rgba(
        165,
        153,
        218,
        0.035
      );
  }


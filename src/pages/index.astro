    flex: 1;
    height: 100%;
    padding:
      0 15px;
    border: 0;
    outline: 0;
    background:
      transparent;
    color:
      var(--text);
    font-family: inherit;
    font-size: 12px;
  }

  .search-box input::placeholder {
    color:
      #55545e;
  }

  .search-label {
    padding-right: 17px;
    color:
      #41404a;
    font-size: 8px;
    letter-spacing: 1.5px;
  }


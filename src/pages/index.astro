    margin-bottom: 55px;
  }

  .search-box {
    height: 54px;
    display: flex;
    align-items: center;
    border:
      1px solid
      var(--border);
    background:
      rgba(
        8,
        7,
        14,
        0.34
      );
    backdrop-filter:
      blur(8px);
    transition:

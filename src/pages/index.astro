<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>YU之宝库</title>
  </head>

  <body>
    <!-- 星空背景 -->
    <div class="stars stars-one"></div>
    <div class="stars stars-two"></div>
    <div class="stars stars-three"></div>

    <!-- 紫色星云 -->
    <div class="nebula nebula-one"></div>
    <div class="nebula nebula-two"></div>

    <main>
      <!-- 顶部导航 -->
      <header class="topbar">
        <a href={import.meta.env.BASE_URL} class="logo">
          YU之宝库
        </a>

        <nav>
          <a href={`${import.meta.env.BASE_URL}archive/`}>案例</a>
          <a href={`${import.meta.env.BASE_URL}qa/`}>Q&A</a>
          <a href={`${import.meta.env.BASE_URL}login/`}>登录</a>
        </nav>
      </header>

      <!-- 主视觉 -->
      <section class="hero">
        <div class="hero-label">
          <span class="dot"></span>
          LEGAL KNOWLEDGE
        </div>

        <h1>
          <span>YU之宝库</span>
        </h1>

        <div class="hero-bottom">
          <div></div>

          <div
            class="time"
            id="clock"
          >
            00:00:00
          </div>
        </div>
      </section>

      <!-- 搜索 -->
      <section class="search-wrap">
        <div class="search-box">
          <span class="search-symbol">
            ⌕
          </span>

          <input
            id="search"
            type="text"
            placeholder="搜索案例、关键词……"
            autocomplete="off"
          />

          <span class="search-label">
            ENTER
          </span>
        </div>
      </section>

      <!-- 法律分类 -->
      <section class="categories">
        <div class="section-heading">
          <span>
            法律分类
          </span>

          <span>
            06
          </span>
        </div>

        <div class="category-grid">

          <a
            href={`${import.meta.env.BASE_URL}archive/?type=民商事`}
            class="category-card"
          >
            <span class="small">
              01
            </span>

            <span class="title">
              民商事
            </span>

            <span class="arrow">
              ↗
            </span>
          </a>

          <a
            href={`${import.meta.env.BASE_URL}archive/?type=劳动`}
            class="category-card"
          >
            <span class="small">
              02
            </span>

            <span class="title">
              劳动
            </span>

            <span class="arrow">
              ↗
            </span>
          </a>

          <a
            href={`${import.meta.env.BASE_URL}archive/?type=知识产权`}
            class="category-card"
          >
            <span class="small">
              03
            </span>

            <span class="title">
              知识产权
            </span>

            <span class="arrow">
              ↗
            </span>
          </a>

          <a
            href={`${import.meta.env.BASE_URL}archive/?type=资本市场`}
            class="category-card"
          >
            <span class="small">
              04
            </span>

            <span class="title">
              资本市场
            </span>

            <span class="arrow">
              ↗
            </span>
          </a>

          <a
            href={`${import.meta.env.BASE_URL}archive/?type=其他`}
            class="category-card"
          >
            <span class="small">
              05
            </span>

            <span class="title">
              其他
            </span>

            <span class="arrow">
              ↗
            </span>
          </a>

          <a
            href={`${import.meta.env.BASE_URL}archive/`}
            class="category-card"
          >
            <span class="small">
              ＋
            </span>

            <span class="title">
              更多分类
            </span>

            <span class="arrow">
              ↗
            </span>
          </a>

        </div>
      </section>

      <!-- 私人资料 -->
      <section class="private-section">
        <div class="section-heading">
          <span>
            私人资料
          </span>

          <span>
            LOCKED
          </span>
        </div>

        <!-- 合同修改常用表述 -->
        <a
          href={`${import.meta.env.BASE_URL}contract-clauses/`}
          class="private-card"
        >
          <div class="private-icon">
            ◇
          </div>

          <div class="private-main">
            <span>
              合同修改常用表述
            </span>

            <small>
              高权限访问
            </small>
          </div>

          <div class="private-arrow">
            →
          </div>
        </a>

        <!-- Q&A -->
        <a
          href={`${import.meta.env.BASE_URL}qa/`}
          class="private-card"
        >
          <div class="private-icon">
            ?
          </div>

          <div class="private-main">
            <span>
              Q&A
            </span>

            <small>
              日常法律问题
            </small>
          </div>

          <div class="private-arrow">
            →
          </div>
        </a>
      </section>

      <!-- 底部 -->
      <footer>
        <span>
          YU
        </span>

        <span id="year"></span>
      </footer>
    </main>

    <script>
      /*
       * ============================
       * 时钟
       * ============================
       */

      const clock =
        document.querySelector("#clock");

      function updateClock() {
        if (!clock) {
          return;
        }

        const now =
          new Date();

        const h =
          String(
            now.getHours()
          ).padStart(2, "0");

        const m =
          String(
            now.getMinutes()
          ).padStart(2, "0");

        const s =
          String(
            now.getSeconds()
          ).padStart(2, "0");

        clock.textContent =
          `${h}:${m}:${s}`;
      }

      updateClock();

      window.setInterval(
        updateClock,
        1000
      );

      /*
       * ============================
       * 年份
       * ============================
       */

      const year =
        document.querySelector("#year");

      if (year) {
        year.textContent =
          String(
            new Date().getFullYear()
          );
      }

      /*
       * ============================
       * 搜索
       * ============================
       */

      const search =
        document.querySelector(
          "#search"
        ) as HTMLInputElement | null;

      if (search) {
        search.addEventListener(
          "keydown",
          (event: KeyboardEvent) => {
            if (
              event.key !== "Enter"
            ) {
              return;
            }

            const keyword =
              search.value.trim();

            if (!keyword) {
              return;
            }

            window.location.href =
              `/archive?search=${encodeURIComponent(
                keyword
              )}`;
          }
        );
      }
    </script>
  </body>
</html>


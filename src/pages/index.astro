  }

  a {
    color: inherit;
    text-decoration: none;
  }

  /*
   * ==================================
   * 顶部导航
   * ==================================
   */

  .topbar {
    height: 45px;
    display: flex;
    align-items: center;
    justify-content:
      space-between;
    border-bottom:
      1px solid
      var(--border);
  }

  /*
   * 普通字体
   */

  .logo {
    font-size: 17px;
    font-weight: 500;
    letter-spacing:
      -0.6px;

    /*
     * 顶部标题也使用
     * 白色 → 淡紫色
     */

    background:
      linear-gradient(
        110deg,
        #ffffff 0%,
        #f5f2ff 40%,
        #c9c0ef 75%,
        #aaa0df 100%
      );

    -webkit-background-clip:
      text;

    -webkit-text-fill-color:
      transparent;

    background-clip:
      text;
  }

  nav {
    display: flex;
    gap: 25px;
  }

  nav a {
    color:
      #686772;
    font-size: 10px;
    transition:
      color 0.2s ease;
  }

  nav a:hover {
    color:
      var(--purple);
  }


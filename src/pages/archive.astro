---
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>案例库｜YU之宝库</title>

    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(body) {
        margin: 0;
        min-height: 100vh;
        background:
          radial-gradient(
            circle at 50% 0%,
            rgba(130, 80, 180, 0.12),
            transparent 35%
          ),
          linear-gradient(180deg, #100d19 0%, #09070e 100%);
        color: #f5f2f8;
        font-family:
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          "PingFang SC",
          "Hiragino Sans GB",
          "Microsoft YaHei",
          sans-serif;
      }

      .topbar {
        height: 72px;
        border-bottom: 1px solid rgba(190, 160, 220, 0.12);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 42px;
      }

      .logo {
        color: #ffffff;
        text-decoration: none;
        font-size: 18px;
        letter-spacing: 0.08em;
      }

      .nav {
        display: flex;
        gap: 24px;
      }

      .nav a {
        color: rgba(255, 255, 255, 0.72);
        text-decoration: none;
        font-size: 13px;
        transition: color 0.2s ease;
      }

      .nav a:hover {
        color: #ffffff;
      }

      main {
        width: min(1080px, calc(100% - 40px));
        margin: 0 auto;
        padding: 65px 0 100px;
      }

      .page-head {
        margin-bottom: 38px;
      }

      .eyebrow {
        color: rgba(220, 200, 235, 0.65);
        font-size: 11px;
        letter-spacing: 0.18em;
        margin-bottom: 14px;
      }

      h1 {
        margin: 0;
        font-size: 30px;
        font-weight: 500;
        letter-spacing: 0.04em;
        color: #ffffff;
      }

      .search-box {
        margin-bottom: 30px;
      }

      .search-box input {
        width: 100%;
        height: 48px;
        border: 1px solid rgba(205, 180, 230, 0.28);
        border-radius: 2px;
        background: rgba(255, 255, 255, 0.035);
        color: #ffffff;
        padding: 0 16px;
        font: inherit;
        font-size: 14px;
        outline: none;
        transition:
          border-color 0.2s ease,
          background 0.2s ease,
          box-shadow 0.2s ease;
      }

      .search-box input:focus {
        border-color: rgba(210, 180, 240, 0.7);
        background: rgba(255, 255, 255, 0.055);
        box-shadow: 0 0 0 3px rgba(145, 100, 190, 0.08);
      }

      .search-box input::placeholder {
        color: rgba(255, 255, 255, 0.5);
      }

      .categories {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 10px;
        margin-bottom: 50px;
      }

      .category {
        min-height: 72px;
        border: 1px solid rgba(205, 180, 230, 0.2);
        background: rgba(255, 255, 255, 0.025);
        color: rgba(255, 255, 255, 0.72);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font: inherit;
        font-size: 13px;
        transition:
          border-color 0.2s ease,
          background 0.2s ease,
          color 0.2s ease;
      }

      .category:hover {
        border-color: rgba(220, 195, 240, 0.55);
        background: rgba(150, 110, 190, 0.08);
        color: #ffffff;
      }

      .category.active {
        border-color: rgba(220, 195, 240, 0.72);
        background: rgba(150, 110, 190, 0.13);
        color: #ffffff;
      }

      .list-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
      }

      .list-title {
        color: rgba(255, 255, 255, 0.82);
        font-size: 13px;
        letter-spacing: 0.12em;
      }

      .count {
        color: rgba(255, 255, 255, 0.6);
        font-size: 11px;
        letter-spacing: 0.08em;
      }

      .archive-list {
        display: grid;
        gap: 12px;
      }

      /*
       * 一个案例 = 一个独立的小卡片
       */
      .archive-card {
        display: block;
        border: 1px solid rgba(205, 180, 230, 0.34);
        background: rgba(20, 15, 29, 0.72);
        padding: 19px 20px;
        border-radius: 2px;
        text-decoration: none;
        color: inherit;

        transition:
          border-color 0.18s ease,
          background 0.18s ease,
          box-shadow 0.18s ease,
          transform 0.18s ease;
      }

      .archive-card:hover {
        border-color: rgba(225, 200, 250, 0.88);
        background: rgba(105, 72, 145, 0.18);
        box-shadow:
          0 0 0 1px rgba(225, 200, 250, 0.1),
          0 8px 28px rgba(35, 17, 58, 0.3);
        transform: translateY(-1px);
      }

      .archive-card:active {
        border-color: #ffffff;
        background: rgba(119, 80, 164, 0.28);
        box-shadow: 0 0 0 3px rgba(190, 150, 235, 0.12);
        transform: translateY(0);
      }

      .archive-row {
        display: flex;
        align-items: center;
        gap: 18px;
      }

      .archive-number {
        width: 34px;
        flex: 0 0 34px;
        color: rgba(255, 255, 255, 0.48);
        font-size: 11px;
        letter-spacing: 0.08em;
      }

      .archive-main {
        min-width: 0;
        flex: 1;
      }

      .archive-title {
        margin: 0;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;

        color: #ffffff;
        font-size: 15px;
        font-weight: 500;
        line-height: 1.5;
      }

      .archive-keywords {
        margin-top: 7px;

        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;

        color: rgba(255, 255, 255, 0.7);
        font-size: 11px;
        line-height: 1.4;
      }

      .archive-keywords.empty {
        color: rgba(255, 255, 255, 0.42);
      }

      .archive-arrow {
        margin-left: 12px;
        color: rgba(255, 255, 255, 0.5);
        font-size: 17px;
        transition:
          color 0.18s ease,
          transform 0.18s ease;
      }

      .archive-card:hover .archive-arrow {
        color: #ffffff;
        transform: translateX(4px);
      }

      .empty {
        border: 1px solid rgba(205, 180, 230, 0.25);
        padding: 34px 24px;
        text-align: center;
        color: rgba(255, 255, 255, 0.65);
        font-size: 13px;
        background: rgba(20, 15, 29, 0.5);
      }

      .empty a {
        display: inline-block;
        margin-top: 14px;
        color: #cbb1df;
        text-decoration: none;
      }

      .empty a:hover {
        color: #ffffff;
      }

      @media (max-width: 760px) {
        .topbar {
          padding: 0 20px;
        }

        main {
          width: min(100% - 28px, 1080px);
          padding-top: 45px;
        }

        .categories {
          grid-template-columns: repeat(2, 1fr);
        }

        .category:last-child {
          grid-column: span 2;
        }

        .archive-card {
          padding: 17px 15px;
        }

        .archive-row {
          gap: 12px;
        }

        .archive-number {
          width: 27px;
          flex-basis: 27px;
        }

        .archive-title {
          font-size: 14px;
        }

        .archive-arrow {
          margin-left: 6px;
        }
      }
    </style>
  </head>

  <body>
    <header class="topbar">
      <a class="logo" href="/">YU之宝库</a>

      <nav class="nav">
        <a href="/archive">案例库</a>
        <a href="/new-archive">新增案例</a>
        <a href="/">首页</a>
      </nav>
    </header>

    <main>
      <div class="page-head">
        <div class="eyebrow">CASE LIBRARY</div>
        <h1>案例库</h1>
      </div>

      <div class="search-box">
        <input
          id="search"
          type="search"
          placeholder="关键词"
        />
      </div>

      <div class="categories">
        <button class="category active" data-type="全部">
          全部
        </button>

        <button class="category" data-type="民商事">
          民商事
        </button>

        <button class="category" data-type="劳动">
          劳动
        </button>

        <button class="category" data-type="知识产权">
          知识产权
        </button>

        <button class="category" data-type="资本市场">
          资本市场
        </button>

        <button class="category" data-type="其他">
          其他
        </button>
      </div>

      <div class="list-head">
        <div class="list-title">CASES</div>
        <div class="count" id="count">读取中……</div>
      </div>

      <div id="archive-list" class="archive-list">
        <div class="empty">
          正在读取案例……
        </div>
      </div>
    </main>

    <script>
      import { supabase } from "../lib/supabase";

      type ArchiveItem = {
        id: number;
        title: string | null;
        type: string | null;
        keywords: string | null;
        result: string | null;
        core_points: string | null;
        facts: string | null;
        issues: string | null;
        legal_basis: string | null;
        related_cases: string | null;
      };

      const archiveList =
        document.querySelector("#archive-list") as HTMLElement | null;

      const count =
        document.querySelector("#count") as HTMLElement | null;

      const search =
        document.querySelector("#search") as HTMLInputElement | null;

      const categoryButtons =
        document.querySelectorAll<HTMLButtonElement>(".category");

      let allArchives: ArchiveItem[] = [];

      let currentType = "全部";

      function escapeHtml(value: string) {
        return value
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#039;");
      }

      function renderArchives() {
        if (!archiveList || !count) {
          return;
        }

        const keyword =
          search?.value.trim().toLowerCase() ?? "";

        const filtered = allArchives.filter((archive) => {
          const typeMatch =
            currentType === "全部" ||
            archive.type === currentType;

          if (!typeMatch) {
            return false;
          }

          if (!keyword) {
            return true;
          }

          /*
           * 搜索仍然覆盖完整案例内容，
           * 只是这些内容不在列表页直接展示。
           */
          const searchableText = [
            archive.title,
            archive.keywords,
            archive.result,
            archive.core_points,
            archive.facts,
            archive.issues,
            archive.legal_basis,
            archive.related_cases,
          ]
            .filter(Boolean)
            .join(" ")
            .toLowerCase();

          return searchableText.includes(keyword);
        });

        count.textContent = `${filtered.length} RECORDS`;

        if (filtered.length === 0) {
          archiveList.innerHTML = `
            <div class="empty">
              没有找到符合条件的案例。
            </div>
          `;

          return;
        }

        archiveList.innerHTML = filtered
          .map(
            (archive, index) => `
              <a
                class="archive-card"
                href="/archive-detail?id=${encodeURIComponent(archive.id)}"
              >
                <div class="archive-row">

                  <div class="archive-number">
                    ${String(index + 1).padStart(2, "0")}
                  </div>

                  <div class="archive-main">

                    <div class="archive-title">
                      ${escapeHtml(
                        archive.title || "未命名案例"
                      )}
                    </div>

                    ${
                      archive.keywords
                        ? `
                          <div class="archive-keywords">
                            关键词：${escapeHtml(
                              archive.keywords
                            )}
                          </div>
                        `
                        : `
                          <div class="archive-keywords empty">
                            暂无关键词
                          </div>
                        `
                    }

                  </div>

                  <div class="archive-arrow">
                    →
                  </div>

                </div>
              </a>
            `
          )
          .join("");
      }

      async function loadArchives() {
        if (!archiveList || !count) {
          return;
        }

        const {
          data: { user },
        } = await supabase.auth.getUser();

        if (!user) {
          count.textContent = "PRIVATE";

          archiveList.innerHTML = `
            <div class="empty">
              <p>这是私人档案空间。</p>
              <a href="/login">登录后查看 →</a>
            </div>
          `;

          return;
        }

        const { data, error } = await supabase
          .from("archives")
          .select("*")
          .eq("user_id", user.id)
          .order("created_at", { ascending: false });

        if (error) {
          console.error(error);

          count.textContent = "ERROR";

          archiveList.innerHTML = `
            <div class="empty">
              读取案例失败，请稍后再试。
            </div>
          `;

          return;
        }

        allArchives = (data ?? []) as ArchiveItem[];

        renderArchives();
      }

      categoryButtons.forEach((button) => {
        button.addEventListener("click", () => {
          currentType =
            button.dataset.type ?? "全部";

          categoryButtons.forEach((item) => {
            item.classList.remove("active");
          });

          button.classList.add("active");

          renderArchives();
        });
      });

      search?.addEventListener("input", () => {
        renderArchives();
      });

      loadArchives();
    </script>
  </body>
</html>